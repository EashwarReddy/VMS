# Run node scripts/setup-local.cjs from the repository root to create this securely.
WORKSPACE_ADMIN_EMAIL=admin@example.com
WORKSPACE_ADMIN_PASSWORD=replace-with-your-own-password-of-at-least-12-characters
WORKSPACE_MONGODB_URI=mongodb://127.0.0.1:27017/vms_workspace
WORKSPACE_PORT=8001
# Enable when serving the public application over HTTPS.
WORKSPACE_SECURE_COOKIES=false
