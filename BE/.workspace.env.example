# Run node scripts/setup-local.cjs from the repository root to create this securely.
WORKSPACE_ADMIN_EMAIL=admin@example.com
WORKSPACE_ADMIN_PASSWORD=replace-with-your-own-password-of-at-least-12-characters
WORKSPACE_MONGODB_URI=mongodb://127.0.0.1:27017/vms_workspace
WORKSPACE_PORT=8001
# Enable when serving the public application over HTTPS.
WORKSPACE_SECURE_COOKIES=false

# Optional email notifications. Set these in BE/.workspace.env, never in Git.
# With email disabled, all in-app notifications still work.
WORKSPACE_EMAIL_ENABLED=false
WORKSPACE_SMTP_HOST=
WORKSPACE_SMTP_PORT=587
WORKSPACE_SMTP_FROM=
WORKSPACE_SMTP_USER=
WORKSPACE_SMTP_PASSWORD=
# Port 587 uses required STARTTLS; port 465 uses TLS from connection start.
# Use your provider's app password where required.
